nextflow.enable.dsl = 2

// 1. Default Pipeline Parameters
params {
    outdir               = './results'
    tracedir             = "${params.outdir}/pipeline_info"
    ref_dir              = '.'
    ref_manifest         = 'assets/references.yaml'
    infra_config         = 'assets/infrastructure.yaml'
    infrastructure_config = 'assets/infrastructure.yaml'
    high_ld_regions      = 'assets/high_ld_regions_hg38.bed'
    workdir              = null
    publish_dir_mode     = 'copy'
    target_build         = 'GRCh38'
    ref_fasta            = null

    container            = 'local/poppca_tools:latest'

    liftover_enabled     = true
    liftover_chain       = null
    liftover_ref_fasta   = null
    liftover_map_dir     = null
    crossmap_cmd         = 'CrossMap.py'

    min_shared_variants  = 100000
    min_subgroup_samples = 30
    maf                  = 0.01
    hwe                  = 1e-6
    geno                 = 0.02
    king_cutoff          = 0.0884
    ld_window            = 50
    ld_step              = 5
    ld_r2                = 0.2
    pca_components       = 10
}

// 2. Infrastructure & Hardware Allocations
def resolvedProjectDir = projectDir ? projectDir.toString() : '.'
def defaultInfrastructurePath = 'assets/infrastructure.yaml'
def infrastructureConfigPath = (params.infrastructure_config ?: params.infra_config ?: defaultInfrastructurePath).toString()
def infrastructureFile = new File(infrastructureConfigPath)
def builtInInfrastructure = [
    environment        : [executor: 'local', container_engine: 'docker', scratch_work_dir: "${resolvedProjectDir}/work"],
    hardware_limits    : [max_cpus: 8, max_memory: '64 GB'],
    process_allocations: [
        default_task: [cpus: 4, memory: '16 GB'],
        heavy_task  : [cpus: 8, memory: '32 GB']
    ]
]

if (params.infrastructure_config && !infrastructureFile.exists() && infrastructureConfigPath != defaultInfrastructurePath) {
    throw new IllegalArgumentException("Infrastructure config not found: ${infrastructureConfigPath}")
}

def infrastructure = infrastructureFile.exists()
    ? new groovy.yaml.YamlSlurper().parseText(infrastructureFile.text) as Map
    : builtInInfrastructure
def environmentConfig = (infrastructure.environment ?: [:]) as Map
def hardwareLimits = (infrastructure.hardware_limits ?: [:]) as Map
def processAllocations = (infrastructure.process_allocations ?: [:]) as Map

def executorName = (environmentConfig.executor ?: 'local').toString()
def containerEngine = (environmentConfig.container_engine ?: 'docker').toString()
def scratchWorkDir = (environmentConfig.scratch_work_dir ?: "${projectDir}/work").toString()

if (!(executorName in ['local', 'slurm', 'awsbatch'])) {
    throw new IllegalArgumentException("Unsupported executor '${executorName}' in ${infrastructureConfigPath}")
}

if (!(containerEngine in ['docker', 'apptainer'])) {
    throw new IllegalArgumentException("Unsupported container engine '${containerEngine}' in ${infrastructureConfigPath}")
}

if (executorName == 'awsbatch' && containerEngine != 'docker') {
    throw new IllegalArgumentException("AWS Batch requires container_engine: docker in ${infrastructureConfigPath}")
}

def maxCpus = Math.max(1, (hardwareLimits.max_cpus ?: 8) as Integer)
def maxMemory = new nextflow.util.MemoryUnit((hardwareLimits.max_memory ?: '64 GB').toString())

def defaultTaskAllocation = (processAllocations.default_task ?: [:]) as Map
def heavyTaskAllocation = (processAllocations.heavy_task ?: defaultTaskAllocation) as Map

def defaultTaskCpus = Math.max(1, Math.min((defaultTaskAllocation.cpus ?: 4) as Integer, maxCpus))
def defaultTaskMemoryRequested = new nextflow.util.MemoryUnit((defaultTaskAllocation.memory ?: '16 GB').toString())
def defaultTaskMemory = defaultTaskMemoryRequested > maxMemory ? maxMemory : defaultTaskMemoryRequested
def heavyTaskCpus = Math.max(1, Math.min((heavyTaskAllocation.cpus ?: defaultTaskCpus) as Integer, maxCpus))
def heavyTaskMemoryRequested = new nextflow.util.MemoryUnit((heavyTaskAllocation.memory ?: defaultTaskMemory.toString()).toString())
def heavyTaskMemory = heavyTaskMemoryRequested > maxMemory ? maxMemory : heavyTaskMemoryRequested
def intersectMemoryRequested = new nextflow.util.MemoryUnit('16 GB')
def intersectMemory = intersectMemoryRequested > maxMemory ? maxMemory : intersectMemoryRequested

def runtimeContainer = containerEngine == 'apptainer' ? "docker://${params.container ?: 'local/poppca_tools:latest'}" : (params.container ?: 'local/poppca_tools:latest')

cleanup = true
workDir = params.workdir ? params.workdir.toString() : scratchWorkDir

process {
    executor      = executorName
    container     = runtimeContainer
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    cpus          = defaultTaskCpus
    memory        = defaultTaskMemory
    time          = 6.h

    withName: PARSE_MANIFEST {
        container = null
        cpus      = 1
        memory    = 1.GB
        time      = 30.m
    }

    withName: NORMALIZE_INPUTS {
        cpus   = defaultTaskCpus
        memory = defaultTaskMemory
        time   = 8.h
    }

    withName: INTERSECT_VARIANTS {
        cpus   = Math.min(2, defaultTaskCpus)
        memory = intersectMemory
        time   = 2.h
    }

    withName: QC_AND_PRUNE {
        cpus   = heavyTaskCpus
        memory = heavyTaskMemory
        time   = 12.h
    }

    withName: GENERATE_GLOBAL_PCA {
        cpus   = heavyTaskCpus
        memory = heavyTaskMemory
        time   = 16.h
    }

    withName: GENERATE_SUBLAYER_PCA {
        cpus   = heavyTaskCpus
        memory = heavyTaskMemory
        time   = 12.h
    }
}

docker.enabled = containerEngine == 'docker'
apptainer.enabled = containerEngine == 'apptainer'
apptainer.autoMounts = containerEngine == 'apptainer'
singularity.enabled = false

profiles {
    docker {
        docker.enabled      = true
        apptainer.enabled   = false
        apptainer.autoMounts = false
        singularity.enabled = false
        process.executor    = 'local'
        process.container   = params.container
    }

    apptainer {
        docker.enabled      = false
        apptainer.enabled   = true
        apptainer.autoMounts = true
        singularity.enabled = false
        process.container   = "docker://${params.container}"
    }

    slurm {
        process.executor    = 'slurm'
        process.queue       = 'general'
        executor.queueSize  = 50
    }

    test {
        params.min_shared_variants  = 10
        params.min_subgroup_samples = 4
        process.cpus                = 2
        process.memory              = 4.GB
        process.time                = 1.h
        workDir                     = params.workdir ? params.workdir.toString() : "${projectDir}/.nextflow-test-work"
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/report.html"
}

trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,rss,peak_rss,vmem,peak_vmem,workdir'
    file      = "${params.tracedir}/trace.txt"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/dag.html"
}

manifest {
    name        = 'nf_PopPCA_refgen'
    author      = 'GitHub Copilot'
    homePage    = 'https://github.com/example/nf_PopPCA_refgen'
    description = 'Two-layer population reference PCA generation pipeline in Nextflow DSL2.'
    version     = '1.0.0'
}